<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9-11 full-backup rules. Only the Room database and the recipe photos in files/images/ are included,
  and each include is limited to device-to-device transfer with requireFlags="deviceToDeviceTransfer", so
  cloud backup still gets nothing. The settings DataStore is not included; Pro is re-verified with Google Play.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="images/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
