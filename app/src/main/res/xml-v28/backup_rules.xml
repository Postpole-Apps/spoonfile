<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9-11. Only a phone-to-phone transfer (requireFlags="deviceToDeviceTransfer") carries the
  recipe database and the photo folder; nothing is sent to cloud backup. DataStore (datastore/) is not
  included, so the cached Pro flag is re-verified with Google Play on the new phone.
-->
<full-backup-content>
    <include domain="database" path="." requireFlags="deviceToDeviceTransfer" />
    <include domain="file" path="images/" requireFlags="deviceToDeviceTransfer" />
</full-backup-content>
