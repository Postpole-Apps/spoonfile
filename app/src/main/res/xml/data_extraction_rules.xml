<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ rules. Cloud backup gets nothing: every domain is excluded and there is no <include>.
  Phone-to-phone (device-to-device) transfer carries only the Room database and the recipe photos in
  files/images/. The settings DataStore is deliberately NOT included, and the Pro flag is re-verified with
  Google Play on every launch, so it never needs to travel. Nothing else is copied behind the user's back;
  Settings > Back up now writes a backup file the user keeps.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="images/" />
    </device-transfer>
    <cross-platform-transfer platform="ios">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cross-platform-transfer>
</data-extraction-rules>
