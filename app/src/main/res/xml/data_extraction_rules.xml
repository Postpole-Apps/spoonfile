<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ rules. Nothing goes to cloud backup. Phone-to-phone (device-transfer) copies only the
  recipe database and the photo folder (images/). DataStore settings (datastore/) are deliberately not
  included, so the cached Pro flag never travels with a transfer: Pro is re-verified with Google Play.
  The same rule applies to Android 9-11 (res/xml-v28/backup_rules.xml) and Android 8 (res/xml/backup_rules.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="images/" />
    </device-transfer>
    <cross-platform-transfer platform="ios">
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cross-platform-transfer>
</data-extraction-rules>
